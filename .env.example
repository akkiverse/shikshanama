# Neon Postgres connection string (added automatically by Vercel Neon Marketplace integration; falls back to SQLite locally/in tests)
DATABASE_URL=

# Vercel Blob read/write token for storing uploaded WebP images
BLOB_READ_WRITE_TOKEN=

# Long random secret used to sign stateless admin session cookies, CSRF tokens, and parent consent links
SESSION_SECRET=

# Email of the initial admin account seeded on first run
ADMIN_EMAIL=

# PBKDF2/bcrypt password hash of the initial admin account (generate with: python3 scripts/hash_password.py)
ADMIN_PASSWORD_HASH=

# Secret salt used to hash visitor IPs for rate limiting, leads, and consent records
IP_HASH_SALT=

# Set to "true" to seed clearly marked fictional sample content and show the Demo Content ribbon; "false" for real launch
DEMO_MODE=true
